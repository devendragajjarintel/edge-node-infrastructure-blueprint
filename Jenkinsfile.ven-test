// Child job (placeholder): consumes parent USB artifacts, deploys VEN, and
// provides a placeholder stage for future test extensions.

properties([
    parameters([
        string(
            name: 'USB_ARTIFACTS_PATH',
            defaultValue: '',
            description: 'Absolute path to usb-installation-files.tar.gz on the agent (produced by parent job).'
        ),
        booleanParam(
            name: 'SKIP_VEN_INSTALL_REUSE_DISK',
            defaultValue: false,
            description: 'Skip VEN deployment and reuse cached ubuntu-disk.img from /tmp/enib-build-cache/.'
        ),
        string(
            name: 'VEN_INSTALL_TIMEOUT',
            defaultValue: '2400',
            description: 'Seconds allowed for VEN deployment (default 40 minutes).'
        ),
        string(
            name: 'PLACEHOLDER_MESSAGE',
            defaultValue: 'Placeholder stage: add VEN test logic here in future.',
            description: 'Message shown by the placeholder stage.'
        )
    ])
])

pipeline {
    agent { label 'fed-node' }

    options {
        timestamps()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    stages {
        stage('Validate Inputs') {
            steps {
                script {
                    if (!params.SKIP_VEN_INSTALL_REUSE_DISK && !params.USB_ARTIFACTS_PATH?.trim()) {
                        error "USB_ARTIFACTS_PATH is required when SKIP_VEN_INSTALL_REUSE_DISK is false."
                    }
                    if (!params.SKIP_VEN_INSTALL_REUSE_DISK && !fileExists(params.USB_ARTIFACTS_PATH)) {
                        error "USB artifacts not found: ${params.USB_ARTIFACTS_PATH}"
                    }
                    echo "USB_ARTIFACTS_PATH:          ${params.USB_ARTIFACTS_PATH ?: '(reusing cached disk)'}"
                    echo "SKIP_VEN_INSTALL_REUSE_DISK: ${params.SKIP_VEN_INSTALL_REUSE_DISK}"
                    echo "VEN_INSTALL_TIMEOUT:         ${params.VEN_INSTALL_TIMEOUT}s"
                }
            }
        }

        stage('Preflight') {
            steps {
                sh '''#!/usr/bin/env bash
                set -euo pipefail

                echo "=== VEN Placeholder Preflight ==="

                if ! command -v qemu-system-x86_64 &>/dev/null; then
                    echo "ERROR: qemu-system-x86_64 not found."
                    exit 1
                fi
                echo "QEMU: $(qemu-system-x86_64 --version | head -1)"

                if ! sudo -n true 2>/dev/null; then
                    echo "ERROR: Non-interactive sudo not available."
                    exit 1
                fi

                echo "Preflight passed."
                '''
            }
        }

        stage('VEN Deployment') {
            when {
                expression { !params.SKIP_VEN_INSTALL_REUSE_DISK }
            }
            steps {
                sh '''#!/usr/bin/env bash
                set -euo pipefail

                echo "=== Virtual Edge Node (VEN) Deployment ==="

                sudo pkill -f "qemu-system-x86_64.*ubuntu-disk" 2>/dev/null || true
                sudo qemu-nbd --disconnect /dev/nbd0 2>/dev/null || true

                sudo rm -rf ven-work && mkdir -p ven-work
                echo "Extracting USB installation artifacts..."
                sudo tar -xzf "${USB_ARTIFACTS_PATH}" -C ven-work/
                cd ven-work

                if [ ! -f ven-deployment.sh ] || [ ! -f config-file ]; then
                    echo "ERROR: Expected ven-deployment.sh and config-file in extracted artifacts."
                    exit 1
                fi

                SSH_PUB=""
                if [ -f ~/.ssh/id_ed25519.pub ]; then
                    SSH_PUB=$(cat ~/.ssh/id_ed25519.pub)
                elif [ -f ~/.ssh/id_rsa.pub ]; then
                    SSH_PUB=$(cat ~/.ssh/id_rsa.pub)
                else
                    echo "WARNING: No SSH public key found; ssh_key remains unchanged."
                fi

                HOST_HP="${http_proxy:-${HTTP_PROXY:-}}"
                HOST_HPS="${https_proxy:-${HTTPS_PROXY:-}}"
                HOST_NP="${no_proxy:-${NO_PROXY:-localhost,127.0.0.1}}"

                while IFS= read -r line; do
                    case "$line" in
                        http_proxy=*)  printf 'http_proxy="%s"\n'  "${HOST_HP}"  ;;
                        https_proxy=*) printf 'https_proxy="%s"\n' "${HOST_HPS}" ;;
                        no_proxy=*)    printf 'no_proxy="%s"\n'    "${HOST_NP}"  ;;
                        HTTP_PROXY=*)  printf 'HTTP_PROXY="%s"\n'  "${HOST_HP}"  ;;
                        HTTPS_PROXY=*) printf 'HTTPS_PROXY="%s"\n' "${HOST_HPS}" ;;
                        NO_PROXY=*)    printf 'NO_PROXY="%s"\n'    "${HOST_NP}"  ;;
                        ssh_key=*)
                            if [ -n "$SSH_PUB" ]; then
                                printf 'ssh_key="%s"\n' "${SSH_PUB}"
                            else
                                echo "$line"
                            fi ;;
                        *) echo "$line" ;;
                    esac
                done < config-file > /tmp/ven-config-file.tmp
                sudo mv /tmp/ven-config-file.tmp config-file

                chmod +x ven-deployment.sh
                if ! grep -q -- '-no-reboot' ven-deployment.sh; then
                    sudo sed -i 's/-vnc :99/-vnc :99 -no-reboot/' ven-deployment.sh
                fi

                echo "Launching VEN deployment (timeout: ${VEN_INSTALL_TIMEOUT}s)..."
                sudo -E ./ven-deployment.sh > /tmp/ven-deployment-full.log 2>&1 &
                VEN_PID=$!

                set +e
                ELAPSED=0
                while kill -0 $VEN_PID 2>/dev/null; do
                    if [ $ELAPSED -ge ${VEN_INSTALL_TIMEOUT} ]; then
                        echo "TIMEOUT: VEN deployment exceeded ${VEN_INSTALL_TIMEOUT}s."
                        sudo pkill -f "qemu-system-x86_64.*ubuntu-disk" 2>/dev/null || true
                        sleep 5
                        sudo kill -9 $VEN_PID 2>/dev/null || true
                        break
                    fi
                    sleep 30
                    ELAPSED=$((ELAPSED + 30))
                    echo "  VEN deployment running... (${ELAPSED}s)"
                done
                wait $VEN_PID 2>/dev/null
                VEN_EXIT=$?
                set -e

                echo "=== ven-deployment-full.log ==="
                cat /tmp/ven-deployment-full.log 2>/dev/null | col -b | cat -s || echo "(no full log)"

                if [ $VEN_EXIT -ne 0 ]; then
                    echo "ERROR: ven-deployment.sh exited with code $VEN_EXIT"
                    exit $VEN_EXIT
                fi

                if [ ! -f ubuntu-disk.img ]; then
                    echo "ERROR: ubuntu-disk.img not created."
                    exit 1
                fi

                mkdir -p /tmp/enib-build-cache
                cp ubuntu-disk.img /tmp/enib-build-cache/ubuntu-disk.img
                echo "PASS: ubuntu-disk.img cached at /tmp/enib-build-cache/ubuntu-disk.img"
                '''
            }
        }

        stage('Restore Cached VEN Disk') {
            when {
                expression { params.SKIP_VEN_INSTALL_REUSE_DISK }
            }
            steps {
                sh '''#!/usr/bin/env bash
                set -euo pipefail

                echo "=== Restoring cached VEN disk ==="
                CACHE_DISK="/tmp/enib-build-cache/ubuntu-disk.img"
                if [ ! -f "$CACHE_DISK" ]; then
                    echo "ERROR: No cached disk found at $CACHE_DISK"
                    exit 1
                fi

                mkdir -p ven-work
                cp "$CACHE_DISK" ven-work/ubuntu-disk.img
                echo "Restored: ven-work/ubuntu-disk.img ($(du -h ven-work/ubuntu-disk.img | cut -f1))"
                '''
            }
        }

        stage('Placeholder Stage') {
            steps {
                sh '''#!/usr/bin/env bash
                set -euo pipefail

                echo "=== Placeholder ==="
                echo "${PLACEHOLDER_MESSAGE}"
                if [ -f ven-work/ubuntu-disk.img ]; then
                    echo "Artifact ready for future test stages: ven-work/ubuntu-disk.img"
                else
                    echo "No local ven-work/ubuntu-disk.img found in this run."
                fi
                '''
            }
        }
    }

    post {
        always {
            sh '''#!/usr/bin/env bash
            echo "=== VEN Placeholder Cleanup ==="
            sudo pkill -f "qemu-system-x86_64.*ubuntu-disk" 2>/dev/null || true
            sudo qemu-nbd --disconnect /dev/nbd0 2>/dev/null || true
            rm -f /tmp/ven-deployment-full.log 2>/dev/null || true
            echo "Cleanup done."
            '''
        }
        success {
            echo 'VEN placeholder child pipeline completed successfully.'
        }
        failure {
            echo 'VEN placeholder child pipeline failed. Check stage logs for details.'
        }
    }
}
